+# Prefer the main-table default route over a logical WAN that may not be the active exit.
+# The main table avoids mistaking Nikki policy-routing tables for the physical uplink.
+get_uplink_device() {
+	local routed_device wan_status wan_up wan_ip wan_ip6 l3_device
+	routed_device=$(ip -4 route show table main default 2>/dev/null | awk '{ for (i=1; i<=NF; i++) if ($i=="dev") { d=$(i+1); if (d!="lo" && d!="br-lan" && d !~ /^ifb/ && d !~ /^(nikki|mihomo)/) { print d; exit } } }')
+	if [ -n "$routed_device" ]; then
+		echo "$routed_device"
+		return
+	fi
+	wan_status=$(ubus call network.interface.wan status 2>/dev/null)
+	wan_up=$(echo "$wan_status" | jsonfilter -e "@.up" 2>/dev/null)
+	l3_device=$(echo "$wan_status" | jsonfilter -e "@.l3_device" 2>/dev/null)
+	wan_ip=$(echo "$wan_status" | jsonfilter -e "@['ipv4-address'][0].address" 2>/dev/null)
+	wan_ip6=$(echo "$wan_status" | jsonfilter -e "@['ipv6-address'][0].address" 2>/dev/null)
+	if [ "$wan_up" = "true" ] && [ -n "$l3_device" ] && { [ -n "$wan_ip" ] || [ -n "$wan_ip6" ]; }; then
+		echo "$l3_device"
+	fi
+}
